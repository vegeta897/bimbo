<form id="form" action="#" onsubmit="sendForm(event)">
    <input id="id" class="input" value="{{ id }}" style="display:none" />
    {{#if formType}}
        <input id="formType" class="input" value="{{ formType }}" style="display:none" />
    {{/if}}
    {{#each fields}}
        {{#if addon}}
            <div class="field is-horizontal">
                <div class="field-body">
                    <div class="field is-expanded">
                        <div class="field has-addons">
                            <p class="control"><a class="button is-static">{{ addon }}</a></p>
                            <p class="control is-expanded">
                                <input
                                    id="{{ id }}"
                                    class="input"
                                    placeholder="{{#if placeholder}}{{ placeholder }}{{else}}{{ id }}{{/if}}"
                                    type="{{#if type}}{{ type }}{{else}}text{{/if}}"
                                    {{#unless optional}}
                                        required
                                    {{/unless}}
                                />
                            </p>
                        </div>
                        <p class="help">{{{ helpText }}}</p>
                    </div>
                </div>
            </div>
        {{else}}
            <div class="field">
                <div class="control">
                    <input
                        id="{{ id }}"
                        class="input"
                        placeholder="{{#if placeholder}}{{ placeholder }}{{else}}{{ id }}{{/if}}"
                        type="{{#if type}}{{ type }}{{else}}text{{/if}}"
                        {{#unless optional}}
                            required
                        {{/unless}}
                    />
                    {{#if helpText}}
                        <p class="help">
                            {{{ helpText }}}
                        </p>
                    {{/if}}
                </div>
            </div>
        {{/if}}
    {{/each}}
    {{#ifEquals formType "deploy"}}
        <div class="block">
            <div class="field">
                <div class="control">
                    <button id="checkDeploy" class="button is-small is-info is-outlined">Test connection</button>
                </div>
            </div>
            <div class="content">
                <code id="checkResult" class="has-text-grey-light">waiting to test...</code>
            </div>
        </div>
    {{/ifEquals}}
    <div class="field is-grouped">
        <div class="control">
            <button class="button is-link">Submit</button>
        </div>
        <div class="control">
            <button class="button is-link is-light" type="button" onclick="window.close()">Cancel</button>
        </div>
    </div>
</form>
<script src="form-handler.js"></script>
<script src="deploy-check.js"></script>
